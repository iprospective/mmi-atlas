# www.env — config de l'interface web Atlas (RM2040). Déposé sur le conteneur en
# 0640 root:atlas-www, HORS versionning. Le déploiement ne l'écrase jamais s'il existe.
#
# Génère l'empreinte du mot de passe (le mdp en clair n'est stocké nulle part) :
#   python3 /opt/atlas/atlas-www.py --hash-password
#
# ── Auth (REQUIS — sans hash, le serveur refuse de démarrer : fail-secure) ──
ATLAS_WWW_USER=atlas
ATLAS_WWW_PASSWORD_HASH=

# ── Écoute ──
# Bind loopback par défaut = sûr. Pour exposer la console (vrack / IP du conteneur),
# mettre l'adresse voulue ET ouvrir le port côté pare-feu en conscience.
ATLAS_WWW_BIND=127.0.0.1
# Convention iProspective : 17443 = HTTPS in-container (TLS=1) ; 17080 = HTTP derrière
# proxy (TLS=0). Ports hauts → aucun privilège requis.
ATLAS_WWW_PORT=17443

# ── TLS (débrayable) ──
# 1 = HTTPS in-container (défaut, cert auto-signé généré par deploy-www.sh).
# 0 = HTTP simple — UNIQUEMENT derrière un proxy qui termine le TLS (ex. Apache SSL).
ATLAS_WWW_TLS=1
ATLAS_WWW_CERT=/opt/atlas/tls/www.crt
ATLAS_WWW_KEY=/opt/atlas/tls/www.key

# ── Derrière un reverse-proxy (Apache SSL) ──
# 1 = prend l'IP cliente dans X-Forwarded-For (anti-brute-force correct) et l'origine
#     CSRF dans X-Forwarded-Host. À activer SEULEMENT si un proxy de confiance est devant.
ATLAS_WWW_TRUST_PROXY=0
#
# Recette type « Apache SSL → atlas-www HTTP loopback » :
#   www.env :  ATLAS_WWW_TLS=0  ATLAS_WWW_BIND=127.0.0.1  ATLAS_WWW_PORT=17080  ATLAS_WWW_TRUST_PROXY=1
#   Apache (vhost :443, SSLEngine on) :
#     ProxyPreserveHost On
#     RequestHeader set X-Forwarded-Proto "https"
#     ProxyPass        / http://127.0.0.1:17080/
#     ProxyPassReverse / http://127.0.0.1:17080/
# (atlas-www reste en loopback : seul Apache l'atteint ; l'auth Basic ne circule jamais en clair.)

# ── CSRF (optionnel ; aléatoire par process si absent — fixer pour stabilité) ──
#ATLAS_WWW_SECRET=
