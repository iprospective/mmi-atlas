[Unit]
# Atlas — bot Telegram sysadmin sécurisé (épic RM1812, déploiement RM1848).
# Déployé dans le conteneur `atlas` sous l'utilisateur dédié non privilégié `atlas-bot`.
Description=Atlas — bot Telegram sysadmin sécurisé
Documentation=https://gitlab.example.net/iprospective/sysadmin/atlas
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atlas-bot
Group=atlas-bot
# Accès au socket du cœur (/run/atlas/atlas.sock, group atlas-ifaces 0660). RM2039.
SupplementaryGroups=atlas-ifaces
WorkingDirectory=/opt/atlas
# Token / whitelist / hash mdp — fichier 0600 hors versionning, rempli sur le conteneur.
EnvironmentFile=/opt/atlas/.env
Environment=ATLAS_SOCKET=/run/atlas/atlas.sock
ExecStart=/usr/bin/python3 -u /opt/atlas/atlas-bot.py
Restart=on-failure
RestartSec=5

# ── Durcissement (socle ; durcissement agressif = RM1818, avec tests) ──
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Relais pur (RM2039) : le bot n'exécute plus, ne sudoe plus, n'écrit aucun audit
# (c'est le cœur qui le fait) → aucun ReadWritePaths nécessaire. NoNewPrivileges
# reste true : la surface exposée ne peut JAMAIS escalader.

[Install]
WantedBy=multi-user.target
