# Atlas bot — configuration (copier en .env, qui est gitignoré)

# Token @BotFather (jamais loggué)
ATLAS_BOT_TOKEN=<bot-token>

# IDs Telegram autorisés, séparés par des virgules (cf. /whoami)
ATLAS_WHITELIST=123456789

# Empreinte PBKDF2 du mot de passe de verrouillage
# Générer avec : python3 atlas-bot.py --hash-password
ATLAS_LOCK_PASSWORD_HASH=

# Optionnel : TTL d'auto-lock en secondes (défaut 120, durci en RM1818)
#ATLAS_AUTO_LOCK_SECONDS=120

# Optionnel : chats où poster les alertes + approbations du moteur (RM1813).
# Défaut = la whitelist (bot privé : chat_id == user_id en messages directs).
#ATLAS_ALERT_CHAT=123456789
