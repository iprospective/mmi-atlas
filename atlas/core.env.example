# core.env — paramètres du cœur Atlas (RM1813). Copier en /opt/atlas/core.env
# (0640 root:atlas) sur le conteneur. Optionnel : sans ce fichier, les défauts
# ci-dessous s'appliquent. `systemctl restart atlas-core` pour prendre en compte.

# ── Ce qu'Atlas a le DROIT de faire (plafond d'autonomie) ────────────────────
#   observe : diagnostic + alerte SEULEMENT — aucune remédiation (DÉFAUT, sûr).
#   approve : toute action passe par une approbation humaine inline (boutons).
#   execute : auto-remédiation P1 autorisée ; P2 toujours en approbation.
ATLAS_AUTONOMY_CEILING=observe

# Diagnostic automatique (ops read-only) joint à chaque alerte. 1=on (défaut).
ATLAS_DIAGNOSE=1

# Péremption d'une approbation P2 en attente (secondes).
#ATLAS_APPROVAL_TTL=600
