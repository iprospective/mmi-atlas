# ingest.env — conf de l'endpoint d'ingestion Atlas (RM1813). 0640 root:atlas-ingest.
# Copier en /opt/atlas/ingest.env sur le conteneur et renseigner. NE PAS versionner rempli.

# Secret HMAC partagé avec le webhook Zabbix (même valeur que la macro {$ATLAS_INGEST_SECRET}).
# Générer : openssl rand -hex 32
ATLAS_INGEST_SECRET=

# IP d'écoute — IP VRACK du conteneur atlas (jamais l'IP publique).
ATLAS_INGEST_BIND=192.0.2.36
ATLAS_INGEST_PORT=8088
